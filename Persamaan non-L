import math

# 1. Definisi Fungsi Persamaan Non-Linear
def f(t):
    # f(t) = 800 * e^(0.3t) - 2000 - 400t
    return 800 * math.exp(0.3 * t) - 2000 - 400 * t

def bisection_method(a, b, tol=1e-4, max_iter=20):
    if f(a) * f(b) >= 0:
        print("Interval awal tidak valid (tidak mengurung akar).")
        return
    
    print(f"{'Iter':<5} | {'a':<10} | {'b':<10} | {'c (t)':<10} | {'f(c)':<10}")
    print("-" * 55)
    
    for i in range(1, max_iter + 1):
        c = (a + b) / 2.0
        fc = f(c)
        
        print(f"{i:<5} | {a:<10.4f} | {b:<10.4f} | {c:<10.4f} | {fc:<10.4f}")
        
        # Cek kondisi berhenti berdasarkan toleransi
        if abs(fc) < tol or (b - a) / 2.0 < tol:
            print("-" * 55)
            print(f"Akar konvergen ditemukan pada t = {c:.4f} setelah {i} iterasi.")
            break
        
        # Tentukan sub-interval baru
        if f(a) * fc < 0:
            b = c
        else:
            a = c

# Eksekusi program dengan batas awal a = 5 dan b = 6
if __name__ == "__main__":
    print("=== PROGRAM METODE BISEKSI: TITIK IMPAS NUSA CHAT ===")
    print("Nama : Lamdan Handika")
